[sub_resource type="Shader" id="Shader_deep_space"]
code = "shader_type sky;\nrender_mode use_half_res_pass;\n\nuniform vec3 nebula_a : source_color = vec3(0.050, 0.026, 0.058);\nuniform vec3 nebula_b : source_color = vec3(0.118, 0.054, 0.022);\nuniform float nebula_strength : hint_range(0.0, 1.0) = 0.55;\nuniform float nebula_scale : hint_range(0.5, 12.0) = 2.6;\nuniform vec3 star_color : source_color = vec3(0.92, 0.94, 1.0);\nuniform float star_density : hint_range(0.0, 400.0) = 170.0;\nuniform float star_strength : hint_range(0.0, 3.0) = 0.8;\n\nvec2 hash22(vec2 p) {\n\tvec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));\n\tp3 += dot(p3, p3.yzx + vec3(33.33));\n\treturn fract((p3.xx + p3.yz) * p3.zy);\n}\n\nfloat value_noise(vec2 p) {\n\tvec2 i = floor(p);\n\tvec2 f = fract(p);\n\tvec2 u = f * f * (3.0 - 2.0 * f);\n\tfloat a = hash22(i).x;\n\tfloat b = hash22(i + vec2(1.0, 0.0)).x;\n\tfloat c = hash22(i + vec2(0.0, 1.0)).x;\n\tfloat d = hash22(i + vec2(1.0, 1.0)).x;\n\treturn mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\n\nfloat fbm(vec2 p) {\n\tfloat v = 0.0;\n\tfloat a = 0.55;\n\tfor (int i = 0; i < 3; i++) {\n\t\tv += a * value_noise(p);\n\t\tp = p * 2.13 + vec2(17.0, -9.0);\n\t\ta *= 0.5;\n\t}\n\treturn v;\n}\n\nvoid sky() {\n\tvec3 dir = EYEDIR;\n\tvec3 col = vec3(0.006, 0.004, 0.010);\n\tvec2 uv = dir.xz / max(0.15, dir.y + 0.55) * nebula_scale;\n\tfloat n1 = fbm(uv + vec2(3.7, -2.2));\n\tfloat n2 = fbm(uv * 1.6 + vec2(-5.1, 4.0) + n1 * 0.9);\n\tfloat dust = smoothstep(0.35, 0.95, n2);\n\tcol += nebula_a * dust * nebula_strength;\n\tfloat warm = smoothstep(0.55, 1.0, n1 * n2 * 2.4);\n\tcol += nebula_b * warm * nebula_strength;\n\tvec2 cell_uv = dir.xz / max(0.15, dir.y + 0.55) * star_density;\n\tvec2 cell = floor(cell_uv);\n\tvec2 f = fract(cell_uv);\n\tvec2 r = hash22(cell);\n\tif (r.x > 1.0 - 0.035) {\n\t\tvec2 star_pos = hash22(cell + 19.19) * 0.6 + 0.2;\n\t\tfloat d = length(f - star_pos);\n\t\tfloat twinkle = 0.75 + 0.25 * sin(TIME * (1.0 + r.y * 3.0) + r.x * 40.0);\n\t\tcol += star_color * smoothstep(0.14, 0.0, d) * star_strength * twinkle;\n\t}\n\tCOLOR = col;\n}\n"

